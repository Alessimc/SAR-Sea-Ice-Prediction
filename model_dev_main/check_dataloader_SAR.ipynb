    "import h5py\n",
    "import numpy as np\n",
    "import torch\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from src.dataloader.h5_loader import H5AllChannelDataset\n",
    "# ^ adjust import path if needed\n",
    "\n",
    "# ------------------------------------------------------------------\n",
    "# Paths\n",
    "# ------------------------------------------------------------------\n",
    "h5_path = f\"{SAR_ROOT}/h5_DriftWindSAR/val_allch.h5\"\n",
    "\n",
    "# IMPORTANT:\n",
    "# These must match how you BUILT the H5 file\n",
    "x_channels = [\n",
    "    \"past_drift_u\",\n",
    "    \"past_drift_v\",\n",
    "    \"future_wind_u10_mean\",\n",
    "    \"future_wind_v10_mean\",\n",
    "    \"sar_hh_db\",\n",
    "    \"sar_hv_db\",\n",
    "    \"sar_incidence_angle\",\n",
    "]\n",
    "\n",
    "# ------------------------------------------------------------------\n",
    "# Quick structural inspection of the HDF5 file\n",
    "# ------------------------------------------------------------------\n",
    "with h5py.File(h5_path, \"r\") as f:\n",
    "    print(\"H5 keys:\")\n",
    "    for k in f.keys():\n",
    "        print(f\"  {k}: shape={f[k].shape}, dtype={f[k].dtype}\")\n",
    "\n",
    "    print(\"\\nAttributes:\")\n",
    "    for k, v in f.attrs.items():\n",
    "        print(f\"  {k}: {v}\")\n",
    "\n",
    "# ------------------------------------------------------------------\n",
    "# Dataset-style access (matches training/inference)\n",
    "# ------------------------------------------------------------------\n",
    "ds = H5AllChannelDataset(\n",
    "    h5_path=h5_path,\n",
    "    x_channel_idx=None,   # load all channels\n",
    "    return_meta=True,\n",
    ")\n",
    "\n",
    "sample = ds[966]\n",
    "\n",
    "x = sample[\"x\"]   # (C,H,W)\n",
    "y = sample[\"y\"]   # (2,H,W)\n",
    "\n",
    "print(\"\\nLoaded sample:\")\n",
    "print(\"x shape:\", x.shape)\n",
    "print(\"y shape:\", y.shape)\n",
    "print(\"x channels:\", x_channels)\n",
    "print(\"id:\", sample.get(\"id\"))\n",
    "print(\"t :\", sample.get(\"t\"))\n",
    "\n",
    "# ------------------------------------------------------------------\n",
    "# Plot each X channel\n",
    "# ------------------------------------------------------------------\n",
    "C, H, W = x.shape\n",
    "fig, axes = plt.subplots(1, C, figsize=(4 * C, 4), squeeze=False)\n",
    "\n",
    "for i, (ax, name) in enumerate(zip(axes[0], x_channels)):\n",
    "    arr = x[i].cpu().numpy()\n",
    "\n",
    "    im = ax.imshow(arr, cmap=\"coolwarm\")\n",
    "    ax.set_title(name)\n",
    "    ax.axis(\"off\")\n",
    "    plt.colorbar(im, ax=ax, fraction=0.046, pad=0.04)\n",
    "\n",
    "plt.suptitle(\"Input channels from HDF5 dataset\", fontsize=14)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
